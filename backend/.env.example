# ==============================================================================
# StormOps Backend — Environment Configuration Template
# Copy this file to backend/.env for local backend development.
# ==============================================================================

# Application Environment
APP_NAME=StormOps
APP_ENV=development
APP_DEBUG=true

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# AI / LLM Provider (Groq Cloud)
AI_PROVIDER=groq
AI_API_KEY=your_groq_api_key_here
AI_MODEL=openai/gpt-oss-120b
AI_API_BASE=https://api.groq.com/openai/v1
AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Database Configuration (PostgreSQL with psycopg 3)
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/stormops

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Weather Provider (Open-Meteo)
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
