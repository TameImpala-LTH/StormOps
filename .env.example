# ==============================================================================
# StormOps — Environment Configuration Template
# Copy this file to .env or backend/.env and populate with your values.
# NEVER commit real credentials or API keys to version control.
# ==============================================================================

# Application Environment
APP_NAME=StormOps
APP_ENV=production
APP_DEBUG=false

# CORS Allowed Origins (comma-separated for multiple origins)
# Example: https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://stormops.vercel.app

# AI / LLM Provider (Groq Cloud)
AI_PROVIDER=groq
AI_API_KEY=your_groq_api_key_here
AI_MODEL=openai/gpt-oss-120b
AI_API_BASE=https://api.groq.com/openai/v1
AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Database Configuration (PostgreSQL with psycopg 3)
# Format: postgresql+psycopg://user:password@host:port/dbname
# Cloud providers like Render supply postgres:// or postgresql:// which StormOps auto-normalizes.
DATABASE_URL=postgresql+psycopg://postgres:your_db_password@localhost:5432/stormops

# Authentication (JWT)
# Generate a strong random 32+ byte string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_production_jwt_secret_key_change_me_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Weather Provider (Open-Meteo)
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
